            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Есть в исходном наборе Postman (192.168.10.65:3738).",
            "body": { "mode": "raw", "raw": "{\n  \"DOC\": [\"{{nomGuid}}\"]\n}" },
            "url": { "raw": "{{baseUrl}}/C1_Nomenklature", "host": ["{{baseUrl}}"], "path": ["C1_Nomenklature"] }
