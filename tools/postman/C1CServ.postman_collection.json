{
  "info": {
    "_postman_id": "c1cserv-0001-4000-9000-000000000001",
    "name": "C1CServ — обмен с 1С",
    "description": "Все ручки сервиса C1CServ: импорт объектов из 1С, обратное создание в 1С, выгрузка в 1С:Бухгалтерию (/exp2/v1).\n\nПеред работой задайте переменную baseUrl (вкладка Variables).\nИсторически сервис работал на http://192.168.10.65:3738 (найдено в Postman этой машины), тестовый стенд — http://192.168.7.143:3738, локально — http://127.0.0.1:3738.\n\nВАЖНО: ошибки импорта приходят в теле ответа с кодом HTTP 201, поле err.errCode (10 — процедура вернула -1, 20 — ошибка MongoDB, 30 — обновление не реализовано, 40 — исключение). Проверять надо тело, а не статус.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:3738", "type": "string" },
    { "key": "guid", "value": "98c5cb6f-9253-11ed-aeb6-9457a5547ba0", "type": "string" },
    { "key": "nomGuid", "value": "880e9560-70ae-11e5-a27e-74d435043ca5", "type": "string" },
    { "key": "refId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Служебные",
      "item": [
        {
          "name": "GET / — проверка живости",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] } }
        },
        {
          "name": "GET /test_db — сквозная проверка до Firebird",
          "request": {
            "method": "GET", "header": [],
            "description": "Вызывает SYS$GET_DB_INFO через fb-port. В ответе поле DB_NAME — это база, в которую сервис РЕАЛЬНО пишет.",
            "url": { "raw": "{{baseUrl}}/test_db", "host": ["{{baseUrl}}"], "path": ["test_db"] }
          }
        }
      ]
    },
    {
      "name": "Импорт из 1С (тело: DOC — список GUID)",
      "item": [
        {
          "name": "POST /C1_ZC — заказ клиента",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"DOC\": [\"{{guid}}\"]\n}" },
            "url": { "raw": "{{baseUrl}}/C1_ZC", "host": ["{{baseUrl}}"], "path": ["C1_ZC"] }
          }
        },
        {
          "name": "POST /C1_Partner — контрагент",
          "request": {
            "method": "POST",
