            "url": { "raw": "{{baseUrl}}/C1_ZC_FILE", "host": ["{{baseUrl}}"], "path": ["C1_ZC_FILE"] }
          }
        }
      ]
    },
    {
      "name": "По ERP-идентификаторам",
      "item": [
        {
          "name": "POST /C1_GUID — найти GUID 1С по ref_id",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Есть в исходном наборе Postman. objectName: Nom | Kontragent | Storage | Measure | City | Country | ZakazClienta | Catalog",
            "body": { "mode": "raw", "raw": "{\n  \"objectName\": \"Nom\",\n  \"ref_id\": {{refId}}\n}" },
            "url": { "raw": "{{baseUrl}}/C1_GUID", "host": ["{{baseUrl}}"], "path": ["C1_GUID"] }
          }
        },
        {
          "name": "POST /C1_upd_nom_by_nom_id — обновить номенклатуру по ERP id",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Есть в исходном наборе Postman.",
            "body": { "mode": "raw", "raw": "{\n  \"REF_ID\": [{{refId}}]\n}" },
            "url": { "raw": "{{baseUrl}}/C1_upd_nom_by_nom_id", "host": ["{{baseUrl}}"], "path": ["C1_upd_nom_by_nom_id"] }
          }
        },
        {
          "name": "POST /C1_set_nom_cnt_by_nom_id — остатки по ERP id",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"NOM\": [{{refId}}]\n}" },
            "url": { "raw": "{{baseUrl}}/C1_set_nom_cnt_by_nom_id", "host": ["{{baseUrl}}"], "path": ["C1_set_nom_cnt_by_nom_id"] }
          }
        }
      ]
    },
    {
      "name": "Обратное направление (ERP → 1С)",
      "item": [
        {
          "name": "POST /ERP_NEW_NOM — создать номенклатуру в 1С",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Реализовано частично: создание каталога и единицы измерения отсутствует.",
            "body": { "mode": "raw", "raw": "{\n  \"REF_ID\": [{{refId}}]\n}" },
            "url": { "raw": "{{baseUrl}}/ERP_NEW_NOM", "host": ["{{baseUrl}}"], "path": ["ERP_NEW_NOM"] }
          }
        },
        {
          "name": "POST /ERP_NEW_CATALOG — создать группу в 1С",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "description": "Только ищет существующий GUID; создание не реализовано.",
            "body": { "mode": "raw", "raw": "{\n  \"REF_ID\": [{{refId}}]\n}" },
            "url": { "raw": "{{baseUrl}}/ERP_NEW_CATALOG", "host": ["{{baseUrl}}"], "path": ["ERP_NEW_CATALOG"] }
          }
        }
      ]
    },
    {
      "name": "Выгрузка в 1С:Бухгалтерию (exp2)",
      "item": [
        {
          "name": "GET /exp2/v1/state — доступность источников",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/exp2/v1/state", "host": ["{{baseUrl}}"], "path": ["exp2", "v1", "state"] } }
        },
        {
          "name": "GET /exp2/v1/nomenclature — номенклатура с кодами 1С",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}/exp2/v1/nomenclature?limit=100", "host": ["{{baseUrl}}"], "path": ["exp2", "v1", "nomenclature"],
              "query": [{ "key": "limit", "value": "100" }, { "key": "cursor", "value": "", "disabled": true }] }
          }
        },
        {
          "name": "GET /exp2/v1/storages — складские единицы",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/exp2/v1/storages", "host": ["{{baseUrl}}"], "path": ["exp2", "v1", "storages"] } }
        },
        {
          "name": "GET /exp2/v1/specifications — спецификации",
          "request": {
            "method": "GET", "header": [],
            "url": { "raw": "{{baseUrl}}/exp2/v1/specifications?limit=200", "host": ["{{baseUrl}}"], "path": ["exp2", "v1", "specifications"],
              "query": [{ "key": "limit", "value": "200" }, { "key": "cursor", "value": "", "disabled": true }] }
          }
        },
        {
          "name": "GET /exp2/v1/requirements — расход в производство",
          "request": {
            "method": "GET", "header": [],
